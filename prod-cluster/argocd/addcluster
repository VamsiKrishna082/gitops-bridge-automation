in new cluster 2

kubectl create sa new-cluster-sa 

kubectl create clusterrolebinding argo-clusterbind --clusterrole=cluster-admin --serviceaccount=default:new-cluster-sa 

kubectl auth can-i create pods --as system:serviceaccount:default:new-cluster-sa - verify whether we can create pods , because the sa is admin.

next we have to create token for service account.
kubectl create token new-cluster-sa 



next we have to add secret in cluster where we installed argo

apiVersion: v1
kind: Secret
metadata:
  name: external
  labels:
    argocd.argoproj.io/secret-type: cluster
type: Opaque
stringData:
  name: external
  server: API_SERVER_ADDRESS
  config: |
    {
      "bearerToken": "SERVICE_ACCOUNT_TOKEN",
      "tlsClientConfig": {
        "insecure": false,
        "caData": "BASE64 ENCODED CERTIFICATE"
      }
    }


